# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/bhyuserbackend

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Ride Configuration
OUTSTATION_DISTANCE_KM=150
QUICKRIDE_TIMEOUT_MS=180000
OUTSTATION_TIMEOUT_MS=300000
QUICKRIDE_SEARCH_RADIUS_KM=10
OUTSTATION_SEARCH_RADIUS_KM=100
MAX_DRIVERS_TO_NOTIFY=20

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Request Configuration
REQUEST_TIMEOUT_MINUTES=5
TIMEOUT_CHECK_INTERVAL=60000

# Notification Configuration
FCM_SERVER_KEY=your_fcm_server_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000
